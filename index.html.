
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0b0b16">
<title>StoryFrame AI Studio</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#0b0b16;color:#f5f3ff;font-family:Arial,sans-serif;padding:18px}
main{max-width:850px;margin:auto}
header{padding:22px 0}
.logo{font-size:26px;font-weight:800;color:#a78bfa}
.sub,.muted{color:#aaa;font-size:13px}
.card{background:#171729;border:1px solid #302d49;border-radius:16px;padding:19px;margin:15px 0}
h2{font-size:19px;margin-top:0}
label{display:block;margin:15px 0 7px;color:#c4b5fd;font-size:14px}
textarea,select{width:100%;padding:13px;border-radius:10px;border:1px solid #393653;background:#10101d;color:white;font-size:15px}
textarea{min-height:115px;resize:vertical}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
button{border:0;border-radius:10px;padding:13px 17px;font-weight:bold;cursor:pointer}
.primary{background:#8b5cf6;color:white;width:100%;margin-top:18px}
.secondary{background:#29243e;color:#ddd;margin:8px 5px 0 0}
.scene{padding:15px;background:#10101d;border:1px solid #34304d;border-radius:12px;margin:12px 0}
.scene h3{color:#c4b5fd;margin-top:0}
footer{text-align:center;color:#777;padding:25px;font-size:12px}
@media(max-width:520px){body{padding:12px}.grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<main>
<header>
<div class="logo">✦ STORYFRAME</div>
<div class="sub">AI Cinematic Storyboard Studio</div>
</header>

<section class="card">
<h2 id="heading">Buat Cerita Sinematik</h2>

<label id="ideaLabel" for="idea">Ide cerita kamu</label>
<textarea id="idea" placeholder="Contoh: Seorang anak menemukan kota rahasia..."></textarea>

<div class="grid">
<div>
<label id="genreLabel" for="genre">Genre</label>
<select id="genre">
<option>Adventure</option>
<option>Fantasy</option>
<option>Action</option>
<option>Horror</option>
<option>Drama</option>
<option>Sci-Fi</option>
<option>Documentary</option>
</select>
</div>
<div>
<label id="styleLabel" for="style">Gaya sinematik</label>
<select id="style">
<option>Epic Cinematic</option>
<option>Dark Cinematic</option>
<option>Emotional</option>
<option>Realistic</option>
<option>Anime</option>
</select>
</div>
<div>
<label id="countLabel" for="count">Jumlah adegan</label>
<select id="count">
<option value="5">5 Scenes</option>
<option value="7">7 Scenes</option>
<option value="10">10 Scenes</option>
<option value="15">15 Scenes</option>
</select>
</div>
<div>
<label id="langLabel" for="lang">Bahasa</label>
<select id="lang">
<option value="id">Bahasa Indonesia</option>
<option value="en">English</option>
</select>
</div>
</div>

<button class="primary" id="generateBtn">✦ Generate Storyboard</button>
<p class="muted" id="notice">Versi ini menggunakan generator template lokal, belum terhubung ke AI.</p>
</section>

<section class="card">
<h2 id="resultTitle">Hasil Storyboard</h2>
<div id="output" class="muted">Hasil storyboard akan muncul di sini.</div>
<button class="secondary" id="copyBtn">Copy Storyboard</button>
<button class="secondary" id="downloadBtn">Export TXT</button>
</section>

<footer>STORYFRAME STUDIO · Creative Storytelling Workspace</footer>
</main>

<script>
const $ = id => document.getElementById(id);
let currentText = "";

function changeLanguage(){
 const en = $("lang").value === "en";
 $("heading").textContent = en ? "Create Your Cinematic Story" : "Buat Cerita Sinematik";
 $("ideaLabel").textContent = en ? "Your story idea" : "Ide cerita kamu";
 $("styleLabel").textContent = en ? "Cinematic style" : "Gaya sinematik";
 $("countLabel").textContent = en ? "Number of scenes" : "Jumlah adegan";
 $("langLabel").textContent = en ? "Language" : "Bahasa";
 $("generateBtn").textContent = en ? "✦ Generate Storyboard" : "✦ Buat Storyboard";
 $("resultTitle").textContent = en ? "Storyboard Result" : "Hasil Storyboard";
 $("copyBtn").textContent = en ? "Copy Storyboard" : "Salin Storyboard";
 $("downloadBtn").textContent = en ? "Export TXT" : "Unduh TXT";
 $("notice").textContent = en ?
 "This version uses a local template generator. AI is not connected yet." :
 "Versi ini menggunakan generator template lokal, belum terhubung ke AI.";
}
$("lang").addEventListener("change", changeLanguage);

function generate(){
 const idea = $("idea").value.trim();
 const count = Number($("count").value);
 const style = $("style").value;
 const genre = $("genre").value;
 const en = $("lang").value === "en";

 if(!idea){
  alert(en ? "Please enter your story idea." : "Masukkan ide cerita terlebih dahulu.");
  return;
 }

 const scenes = [];
 const intro = en ? "Opening shot" : "Adegan pembuka";
 const ending = en ? "Closing shot" : "Adegan penutup";

 for(let i=1;i<=count;i++){
  let part;
  if(i===1) part=intro;
  else if(i===count) part=ending;
  else part=en ? "Story development" : "Perkembangan cerita";

  const narration = en
   ? `The story explores ${idea}.`
   : `Cerita mengeksplorasi ${idea}.`;

  scenes.push({
   title:`${en?"Scene":"Adegan"} ${i} — ${part}`,
   visual:`${idea}. ${style} visual treatment, ${genre} atmosphere.`,
   camera: i===1 ? "Wide establishing shot" : "Cinematic medium shot, slow camera movement",
   narration,
   sound:"Atmospheric cinematic soundtrack"
  });
 }

 currentText = `STORYFRAME STORYBOARD\n${idea}\nGenre: ${genre}\nStyle: ${style}\n\n`;
 $("output").innerHTML = "";

 scenes.forEach((s,i)=>{
  currentText += `${s.title}\nVisual: ${s.visual}\nCamera: ${s.camera}\nNarration: ${s.narration}\nSound: ${s.sound}\n\n`;

  const article=document.createElement("article");
  article.className="scene";
  const title=document.createElement("h3");
  title.textContent=s.title;
  article.appendChild(title);

  [["Visual",s.visual],["Camera",s.camera],["Narration",s.narration],["Sound",s.sound]].forEach(([label,value])=>{
   const p=document.createElement("p");
   const strong=document.createElement("strong");
   strong.textContent=label+": ";
   p.appendChild(strong);
   p.appendChild(document.createTextNode(value));
   article.appendChild(p);
  });
  $("output").appendChild(article);
 });
}


async function generate(){
 const idea = $("idea").value.trim();
 const count = Number($("count").value);
 const style = $("style").value;
 const genre = $("genre").value;
 const language = $("lang").value;
 const en = language === "en";

 if(!idea){
  alert(en ? "Please enter your story idea." : "Masukkan ide cerita terlebih dahulu.");
  return;
 }

 const button = $("generateBtn");
 const output = $("output");

 button.disabled = true;
 button.textContent = en ? "Connecting..." : "Menghubungkan...";
 output.textContent = en ? "Contacting StoryFrame server..." : "Menghubungi server StoryFrame...";

 try {
  const response = await fetch("/api/generate", {
   method: "POST",
   headers: {
    "Content-Type": "application/json"
   },
   body: JSON.stringify({
    idea,
    scenes: count,
    style,
    genre,
    language
   })
  });

  const data = await response.json();

  if(!response.ok){
   throw new Error(data.message || data.error || "AI is not ready yet.");
  }

  output.textContent = JSON.stringify(data, null, 2);

 } catch(error) {
  output.textContent = en
   ? "Server connection failed or AI is not configured yet: " + error.message
   : "Koneksi server gagal atau AI belum dikonfigurasi: " + error.message;
 } finally {
  button.disabled = false;
  button.textContent = en ? "✦ Generate Storyboard" : "✦ Buat Storyboard";
 }
}


$("copyBtn").addEventListener("click",async()=>{
 if(!currentText){
  alert("Buat storyboard terlebih dahulu.");
  return;
 }
 try{
  await navigator.clipboard.writeText(currentText);
  alert("Storyboard berhasil disalin!");
 }catch(e){
  alert("Fitur salin tidak tersedia. Gunakan Export TXT.");
 }
});

$("downloadBtn").addEventListener("click",()=>{
 if(!currentText){
  alert("Buat storyboard terlebih dahulu.");
  return;
 }
 const blob=new Blob([currentText],{type:"text/plain;charset=utf-8"});
 const url=URL.createObjectURL(blob);
 const a=document.createElement("a");
 a.href=url;
 a.download="storyframe-storyboard.txt";
 a.click();
 URL.revokeObjectURL(url);
});
</script>
</body>
</html>
